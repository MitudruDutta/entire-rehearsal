#!/usr/bin/env python3
"""entire rehearsal: which coding-agent session changed your AI agent, and does that version still work?

An Entire CLI plugin. Entire records the coding-agent session behind every commit as a checkpoint. Rehearsal
tests an AI agent on a sandboxed copy of a real application and decides every outcome from the application's own
database. This plugin joins the two for the AI agent you are building: its instructions (the system prompt) and,
optionally, the code of its tools.

  entire rehearsal init INSTRUCTIONS [--code PATH...] [--world WV]   describe the agent once (.entire/rehearsal.json)
  entire rehearsal history     every change to the agent, with its checkpoint, coding agent, and changed functions
  entire rehearsal status      is the current version rehearsed? lists the changes nobody has tested yet
  entire rehearsal check       rehearse the current version on a Rehearsal world (spends model budget; asks first)
  entire rehearsal attach RUN  record an existing Rehearsal run against the latest change
  entire rehearsal report      each rehearsed change next to its verdict; a regression shows the session and its intent
  entire rehearsal gate        exit 1 unless the current version is rehearsed and ready to pilot (for CI)
  entire rehearsal sync        push and fetch the shared results (git notes, refs/notes/rehearsal)

Results are git notes on the commits they rehearse, so a team shares them with a push. Changes to tool code are
summarised with entire-graph when it is installed. check and attach need the Rehearsal client
(pip install rehearsal-kit) and a sign-in (rehearsal login).
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

__version__ = "0.2.0"
READY_SUCCESS, READY_MIN_EPISODES = 0.8, 3  # the same bar as Rehearsal's "Ready to pilot"
CONFIG = ".entire/rehearsal.json"
NOTES = "rehearsal"  # refs/notes/rehearsal


class Fail(Exception):
    """A user-facing error: printed without a traceback."""


# --------------------------------------------------------------------------- git and entire


def git(*args: str, check: bool = True) -> str:
    p = subprocess.run(["git", "-C", str(root()), *args], capture_output=True, text=True)
    if check and p.returncode:
        raise Fail(f"git {args[0]} failed: {p.stderr.strip()[:300]}")
    return p.stdout


_root: Path | None = None


def root() -> Path:
    global _root
    if _root is None:
        env = os.environ.get("ENTIRE_REPO_ROOT")
        p = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
        if not env and p.returncode:
            raise Fail("run this inside a git repository")
        _root = Path(env or p.stdout.strip())
    return _root


def entire(*args: str, timeout: int = 120) -> str | None:
    try:
        p = subprocess.run(["entire", *args], capture_output=True, text=True, timeout=timeout, cwd=root())
    except (OSError, subprocess.TimeoutExpired):
        return None
    return p.stdout if p.returncode == 0 else None


def under(path: str, prefix: str) -> bool:
    prefix = prefix.rstrip("/")
    return path == prefix or path.startswith(prefix + "/")


def changes(agent: dict, limit: int = 50) -> list[dict]:
    """Commits that changed the agent (instructions or code), newest first, with their Entire-Checkpoint trailer and
    which part of the agent each one touched."""
    paths = [agent["instructions"], *agent["code"]]
    fmt = "%x1e%H%x1f%cI%x1f%an%x1f%s%x1f%(trailers:key=Entire-Checkpoint,valueonly,separator=%x2c)"
    follow = ["--follow"] if len(paths) == 1 else []
    out = git("log", *follow, f"-n{limit}", "--name-only", f"--format={fmt}", "--", *paths)
    rows = []
    for record in out.split("\x1e")[1:]:
        header, *files = record.strip("\n").split("\n")
        fields = header.split("\x1f")
        if len(fields) != 5:
            continue
        sha, date, author, subject, trailer = fields
        files = [f for f in files if f]
        parts = []
        if len(paths) == 1 or any(f == agent["instructions"] for f in files):
            parts.append("instructions")
        if any(under(f, c) for f in files for c in agent["code"]):
            parts.append("code")
        rows.append({"commit": sha, "date": date, "author": author, "subject": subject,
                     "checkpoint": trailer.split(",")[0].strip(), "parts": parts or ["instructions"]})
    return rows


def session_of(checkpoint: str) -> dict:
    """The coding agent and model behind a checkpoint (entire checkpoint explain --json)."""
    if not checkpoint or (out := entire("checkpoint", "explain", checkpoint, "--json", timeout=60)) is None:
        return {}
    try:
        data = json.loads(out)
    except ValueError:
        return {}
    sessions = (data.get("sessions") or []) if isinstance(data, dict) else []
    first = sessions[0] if sessions else {}
    return {"agent": first.get("agent", ""), "model": first.get("model", ""), "session": first.get("session_id", "")}


def intent_of(checkpoint: str) -> str:
    """What the person asked the coding agent for, from the checkpoint's Intent section."""
    out = entire("checkpoint", "explain", checkpoint, "--short", timeout=60) if checkpoint else None
    if not out or "## Intent" not in out:
        return ""
    section = out.split("## Intent", 1)[1].split("\n## ", 1)[0]
    line = next((l.strip() for l in section.splitlines() if l.strip()), "")
    return line[:160]


def code_changes(commit: str, code: list[str]) -> list[dict]:
    """Functions and classes of the agent's tool code that a commit changed, from entire-graph (empty without it)."""
    if not code or not git("rev-parse", "--verify", "--quiet", f"{commit}^", check=False).strip():
        return []
    out = entire("graph", "diff", "--base", f"{commit}^", "--head", commit, "--json", "--max-seconds", "60", "--", *code, timeout=90)
    try:
        files = json.loads(out or "{}").get("files") or []
    except ValueError:
        return []
    found = [{"file": f.get("path"), "type": c.get("type"), "kind": c.get("kind"), "name": c.get("name"), "dependents": c.get("dependents_count", 0)}
             for f in files for c in (f.get("changes") or [])]
    return sorted(found, key=lambda c: (c["type"] != "signature_changed", -(c["dependents"] or 0)))


def describe_code(found: list[dict], limit: int = 3) -> str:
    words = {"signature_changed": "signature changed", "body_changed": "changed", "added": "added", "removed": "removed", "renamed": "renamed"}
    def one(c: dict) -> str:
        if c.get("kind") == "module":  # module-level code such as constants or tables, not one function
            return f"top-level code in {c['name']} {words.get(c['type'], c['type'])}"
        return f"{c['name']} {words.get(c['type'], c['type'])} ({c['dependents']} dependents)"
    shown = [one(c) for c in found[:limit]]
    return ", ".join(shown) + (f", +{len(found) - limit} more" if len(found) > limit else "")


# --------------------------------------------------------------------------- the agent and its results


def load_config() -> dict:
    try:
        return json.loads((root() / CONFIG).read_text())
    except (OSError, ValueError):
        return {}


def repo_path(path: str) -> str:
    p = Path(path)
    p = p if p.is_absolute() else Path.cwd() / p
    try:
        return str(p.resolve().relative_to(root().resolve()))
    except ValueError:
        raise Fail(f"{path} is not inside this repository") from None


def agent_for(file: str | None) -> dict:
    cfg = load_config()
    if file is None and not cfg.get("instructions"):
        raise Fail(f"name the agent's instructions file, or describe the agent once with `entire rehearsal init` ({CONFIG})")
    instructions = repo_path(file) if file else cfg["instructions"]
    same = instructions == cfg.get("instructions")
    return {"instructions": instructions, "code": list(cfg.get("code") or []) if same else [], "world": cfg.get("world") if same else None,
            "split": cfg.get("split", "dev") if same else "dev", "name": cfg.get("name") if same else None, "model": cfg.get("model") if same else None,
            "min_success": float(cfg.get("min_success", READY_SUCCESS)) if same else READY_SUCCESS}


def results(agent: dict) -> dict[str, dict]:
    """The latest recorded result per commit for this agent, read from git notes."""
    out: dict[str, dict] = {}
    for line in git("notes", f"--ref={NOTES}", "list", check=False).splitlines():
        try:
            note, commit = line.split()
        except ValueError:
            continue
        for text in git("cat-file", "-p", note, check=False).splitlines():
            try:
                r = json.loads(text)
            except ValueError:
                continue
            if r.get("agent") == agent["instructions"]:
                out[commit] = r
    return out


def save(commit: str, record: dict) -> None:
    git("notes", f"--ref={NOTES}", "append", "-m", json.dumps(record, sort_keys=True), commit)


def verdict(overall: dict, min_success: float = READY_SUCCESS) -> str:
    """Rehearsal's readiness bar applied to one run: enough finished episodes, a high verified rate, no rule
    violations, no false "done" claims."""
    finished, rate = overall.get("finished") or 0, overall.get("success_rate")
    if finished < READY_MIN_EPISODES or rate is None:
        return "not enough episodes"
    if rate >= min_success and not overall.get("hard_violation_episodes") and not overall.get("false_completions"):
        return "ready to pilot"
    return "needs work"


def describe(overall: dict) -> str:
    rate = overall.get("success_rate")
    return (f"{'—' if rate is None else f'{rate:.0%}'} verified of {overall.get('finished', 0)} episodes, "
            f"{overall.get('hard_violation_episodes', 0)} rule violations, {overall.get('false_completions', 0)} false 'done', "
            f"{overall.get('duplicate_effects', 0)} duplicate effects")


def client():
    try:
        from rehearsal.sdk import Rehearsal
    except ImportError:
        raise Fail("the Rehearsal client is missing. Install it with: pip install rehearsal-kit") from None
    try:
        return Rehearsal()
    except ValueError as exc:  # no API key: not signed in
        raise Fail(f"{exc}. In CI, pass the key through Entire with ENTIRE_PLUGIN_ENV='REHEARSAL_*'") from None


def record_run(rh, run_id: str, agent: dict, change: dict, extra: dict | None = None) -> dict:
    run = rh.runs.get(run_id)
    overall = (run.get("summary") or {}).get("overall") or {}
    finished = run.get("status") == "finished"
    record = {"agent": agent["instructions"], "commit": change["commit"], "checkpoint": change["checkpoint"], "run_id": run_id,
              "world_version_id": run.get("world_version_id"), "status": run.get("status"), "overall": overall,
              "verdict": verdict(overall, agent["min_success"]) if finished else run.get("status"),
              "recorded_at": datetime.now(timezone.utc).isoformat(timespec="seconds"), **(extra or {})}
    if finished or extra:
        save(change["commit"], record)
    return record


def who(change: dict) -> str:
    s = session_of(change["checkpoint"])
    if s.get("agent"):
        return f"{s['agent']} ({s['model']})" if s.get("model") else s["agent"]
    return "no checkpoint" if not change["checkpoint"] else "checkpoint not available here"


def emit(as_json: bool, data, lines: list[str]) -> None:
    print(json.dumps(data, indent=2) if as_json else "\n".join(lines))


# --------------------------------------------------------------------------- commands


def cmd_init(a: argparse.Namespace) -> None:
    instructions = repo_path(a.instructions)
    if not (root() / instructions).is_file():
        raise Fail(f"{a.instructions} does not exist")
    code = [repo_path(c) for c in a.code]
    for c in code:
        if not (root() / c).exists():
            raise Fail(f"{c} does not exist")
    cfg = {k: v for k, v in {"instructions": instructions, "code": code, "world": a.world, "split": a.split, "name": a.name, "model": a.model,
                             "min_success": a.min_success}.items() if v not in (None, [])}
    path = root() / CONFIG
    path.parent.mkdir(exist_ok=True)
    path.write_text(json.dumps(cfg, indent=2) + "\n")
    print(f"wrote {CONFIG}: {instructions}" + (f" + {', '.join(code)}" if code else "") + ". Commit it so your team rehearses the same agent.")


def cmd_history(a: argparse.Namespace) -> None:
    agent = agent_for(a.file)
    rows = changes(agent, a.limit)
    if not rows:
        raise Fail(f"no commits changed {agent['instructions']}")
    done = results(agent)
    lines = [f"Changes to the agent ({agent['instructions']}" + (f" + {', '.join(agent['code'])}" if agent["code"] else "") + "), newest first", ""]
    for r in rows:
        r["by"] = who(r)
        r["code_changes"] = code_changes(r["commit"], agent["code"]) if "code" in r["parts"] and not a.no_graph else []
        r["result"] = done.get(r["commit"])
        lines.append(f"{r['commit'][:8]}  {r['date'][:16].replace('T', ' ')}  [{'+'.join(r['parts'])}]  {r['subject'][:64].rstrip()}")
        lines.append(f"          checkpoint {r['checkpoint'] or '—'} · {r['by']}")
        if r["code_changes"]:
            lines.append(f"          code       {describe_code(r['code_changes'])}")
        if r["result"]:
            lines.append(f"          rehearsal  {r['result']['verdict']}: {describe(r['result']['overall'])}  [{r['result']['run_id']}]")
    emit(a.json, rows, lines)


def cmd_status(a: argparse.Namespace) -> None:
    agent = agent_for(a.file)
    rows = changes(agent, 200)
    if not rows:
        raise Fail(f"no commits changed {agent['instructions']}")
    done = results(agent)
    last = next((i for i, r in enumerate(rows) if r["commit"] in done), None)
    untested = rows if last is None else rows[:last]
    for r in untested:
        r["by"] = who(r)
        r["code_changes"] = code_changes(r["commit"], agent["code"]) if "code" in r["parts"] and not a.no_graph else []
    current, tested = rows[0], (rows[last] if last is not None else None)
    state = {"current": current["commit"], "tested": bool(tested and tested is current),
             "last_rehearsed": {**tested, "result": done[tested["commit"]]} if tested else None, "untested_changes": untested}
    lines = [f"Agent: {agent['instructions']}" + (f" + {', '.join(agent['code'])}" if agent["code"] else ""),
             f"Current version: {current['commit'][:8]} {current['subject'][:64].rstrip()}"]
    if tested:
        res = done[tested["commit"]]
        lines.append(f"Last rehearsed:  {tested['commit'][:8]} {res['verdict']}: {describe(res['overall'])}  [{res['run_id']}]")
    else:
        lines.append("Last rehearsed:  never")
    if untested:
        lines += ["", f"{len(untested)} change{'s' if len(untested) != 1 else ''} not rehearsed yet:"]
        for r in untested:
            lines.append(f"  {r['commit'][:8]}  [{'+'.join(r['parts'])}]  {r['subject'][:60].rstrip()}  · checkpoint {r['checkpoint'] or '—'} · {r['by']}")
            if r["code_changes"]:
                lines.append(f"            code: {describe_code(r['code_changes'])}")
        lines += ["", "Rehearse it with: entire rehearsal check" + ("" if agent["world"] else " --world <world version id>")]
    else:
        lines.append("\nThe current version is rehearsed.")
    emit(a.json, state, lines)


def cmd_check(a: argparse.Namespace) -> None:
    agent = agent_for(a.file)
    world, split = a.world or agent["world"], a.split or agent["split"]
    if not world:
        raise Fail(f"say which world to rehearse on: --world <id> (rehearsal worlds list), or set it in {CONFIG}")
    rows = changes(agent, 1)
    if not rows:
        raise Fail(f"commit {agent['instructions']} first, so the result belongs to the change that made it")
    head = rows[0]
    paths = [agent["instructions"], *agent["code"]]
    dirty = bool(git("status", "--porcelain", "--", *paths).strip())
    if dirty:
        print(f"warning: the agent has uncommitted changes; the result is recorded against {head['commit'][:8]} and marked dirty", file=sys.stderr)
    if not a.yes:
        if not sys.stdin.isatty():
            raise Fail("check starts an evaluation that spends model budget; pass --yes to confirm")
        if input("This starts a Rehearsal evaluation, which spends model budget. Continue? [y/N] ").strip().lower() != "y":
            raise Fail("cancelled")
    rh = client()
    name = a.name or agent["name"] or Path(agent["instructions"]).stem
    model = a.model or agent["model"]
    prompt = (root() / agent["instructions"]).read_text()
    profile = rh.profiles.create(name, system_prompt=prompt, **({"model": model} if model else {}))
    ev = rh.evaluations.create(world, [profile["id"]], splits=[split], repeats=a.repeats)
    run_id = ev["run_id"]
    print(f"rehearsing {name} v{profile.get('version', '?')} on {world} ({split}): run {run_id}, {ev.get('episodes', '?')} episodes")
    extra = {"profile_id": profile["id"], "split": split, "dirty": dirty}
    if a.no_wait:
        print(f"started; when it finishes: entire rehearsal attach {run_id}")
        return
    deadline = time.time() + a.timeout * 60
    while (status := rh.runs.get(run_id).get("status")) not in ("finished", "failed", "cancelled"):
        if time.time() > deadline:
            raise Fail(f"run {run_id} is still {status} after {a.timeout} minutes; later: entire rehearsal attach {run_id}")
        time.sleep(10)
    res = record_run(rh, run_id, agent, head, extra)
    print(f"{res['verdict']}: {describe(res['overall'])}" if status == "finished" else f"run {status}")


def cmd_attach(a: argparse.Namespace) -> None:
    agent = agent_for(a.file)
    rows = changes(agent, 500)
    if not rows:
        raise Fail(f"no commits changed {agent['instructions']}")
    target = rows[0] if not a.commit else next((r for r in rows if r["commit"].startswith(a.commit)), None)
    if target is None:
        raise Fail(f"{a.commit} did not change the agent")
    res = record_run(client(), a.run_id, agent, target)
    if res["status"] != "finished":
        raise Fail(f"run {a.run_id} is {res['status']}; attach it once it has finished")
    print(f"recorded {a.run_id} for {target['commit'][:8]} ({target['checkpoint'] or 'no checkpoint'}): {res['verdict']}, {describe(res['overall'])}")


def cmd_report(a: argparse.Namespace) -> None:
    agent = agent_for(a.file)
    rows, done = changes(agent, a.limit), results(agent)
    checked = [r for r in rows if r["commit"] in done]
    if not checked:
        raise Fail(f"no rehearsal results for {agent['instructions']} yet; run `entire rehearsal check`")
    for i, r in enumerate(reversed(checked)):  # oldest first, to compare each with the one before
        r["result"] = done[r["commit"]]
        rate = (r["result"]["overall"] or {}).get("success_rate")
        prev = (list(reversed(checked))[i - 1]["result"]["overall"] or {}).get("success_rate") if i else None
        r["change"] = None if rate is None or prev is None else ("better" if rate > prev else "regression" if rate < prev else "same")
    lines = [f"Rehearsal results for {agent['instructions']}, newest first", ""]
    for r in checked:
        r["by"] = who(r)
        if r["change"] == "regression":
            r["intent"] = intent_of(r["checkpoint"])
        mark = {"better": " ▲ better", "regression": " ▼ REGRESSION", "same": " = same"}.get(r["change"] or "", "")
        lines.append(f"{r['commit'][:8]}  {r['result']['verdict']}{mark}  {describe(r['result']['overall'])}")
        lines.append(f"          [{'+'.join(r['parts'])}] {r['subject'][:64].rstrip()}")
        lines.append(f"          changed in checkpoint {r['checkpoint']} by {r['by']}" if r["checkpoint"] else "          changed without an Entire checkpoint")
        if r.get("intent"):
            lines.append(f"          asked for: \"{r['intent']}\"")
    if any(r["change"] == "regression" for r in checked):
        lines += ["", "Read the session behind a regression with: entire checkpoint explain <checkpoint>"]
    emit(a.json, checked, lines)


def cmd_gate(a: argparse.Namespace) -> None:
    agent = agent_for(a.file)
    if a.min_success is not None:
        agent["min_success"] = a.min_success
    rows = changes(agent, 1)
    if not rows:
        raise Fail(f"no commits changed {agent['instructions']}")
    res = results(agent).get(rows[0]["commit"])
    if res is None:
        print(f"gate: the current version ({rows[0]['commit'][:8]}) has not been rehearsed. Run: entire rehearsal check", file=sys.stderr)
        sys.exit(1)
    v = verdict(res["overall"], agent["min_success"])
    print(f"gate: {rows[0]['commit'][:8]} {v}: {describe(res['overall'])}  [{res['run_id']}]")
    sys.exit(0 if v == "ready to pilot" else 1)


def cmd_sync(a: argparse.Namespace) -> None:
    ref = f"refs/notes/{NOTES}"
    fetched = subprocess.run(["git", "-C", str(root()), "fetch", a.remote, f"+{ref}:refs/notes/{NOTES}-remote"], capture_output=True, text=True)
    if fetched.returncode == 0:
        git("notes", f"--ref={NOTES}", "merge", "-s", "cat_sort_uniq", f"refs/notes/{NOTES}-remote", check=False)
    if not git("notes", f"--ref={NOTES}", "list", check=False).strip():
        raise Fail("no results to share yet")
    git("push", a.remote, ref)
    print(f"shared rehearsal results with {a.remote} ({ref})")


def main(argv: list[str] | None = None) -> None:
    p = argparse.ArgumentParser(prog="entire rehearsal", description=__doc__.split("\n\n")[0], formatter_class=argparse.RawDescriptionHelpFormatter,
                                epilog="\n\n".join(__doc__.split("\n\n")[1:]))
    p.add_argument("--version", action="version", version=f"entire-rehearsal {__version__}")
    sub = p.add_subparsers(dest="cmd", required=True)

    i = sub.add_parser("init", help="describe the agent once: its instructions, tool code and world")
    i.add_argument("instructions"); i.add_argument("--code", action="append", default=[], help="a file or folder of the agent's tools (repeatable)")
    i.add_argument("--world", help="world version id to rehearse on"); i.add_argument("--split", default="dev", choices=["train", "dev", "holdout"])
    i.add_argument("--name"); i.add_argument("--model"); i.add_argument("--min-success", type=float)

    def agent_args(sp, json_out=False):
        sp.add_argument("file", nargs="?", help=f"the agent's instructions file (default: from {CONFIG})")
        if json_out:
            sp.add_argument("--json", action="store_true", help="machine-readable output")
        return sp

    h = agent_args(sub.add_parser("history", help="every change to the agent, with checkpoints and changed functions"), True)
    h.add_argument("--limit", type=int, default=20); h.add_argument("--no-graph", action="store_true", help="skip the entire-graph summary of code changes")
    s = agent_args(sub.add_parser("status", help="is the current version rehearsed? which changes are not?"), True)
    s.add_argument("--no-graph", action="store_true")
    c = agent_args(sub.add_parser("check", help="rehearse the current version (spends model budget)"))
    c.add_argument("--world"); c.add_argument("--split", choices=["train", "dev", "holdout"]); c.add_argument("--repeats", type=int, default=1)
    c.add_argument("--name"); c.add_argument("--model"); c.add_argument("--yes", action="store_true", help="do not ask before spending")
    c.add_argument("--no-wait", action="store_true"); c.add_argument("--timeout", type=int, default=120, help="minutes to wait (default 120)")
    t = sub.add_parser("attach", help="record an existing Rehearsal run against a change")
    t.add_argument("run_id"); agent_args(t); t.add_argument("--commit", help="the change to record it against (default: the latest)")
    r = agent_args(sub.add_parser("report", help="each rehearsed change next to its verdict"), True)
    r.add_argument("--limit", type=int, default=50)
    g = agent_args(sub.add_parser("gate", help="exit 1 unless the current version is rehearsed and ready (for CI)"))
    g.add_argument("--min-success", type=float, help="verified rate needed (default 0.8)")
    y = sub.add_parser("sync", help="share results: fetch, merge and push refs/notes/rehearsal")
    y.add_argument("--remote", default="origin")

    a = p.parse_args(argv)
    commands = {"init": cmd_init, "history": cmd_history, "status": cmd_status, "check": cmd_check, "attach": cmd_attach,
                "report": cmd_report, "gate": cmd_gate, "sync": cmd_sync}
    try:
        commands[a.cmd](a)
    except Fail as exc:
        sys.exit(f"entire rehearsal: {exc}")
    except Exception as exc:  # the Rehearsal client raises RehearsalError with the server's reason
        if type(exc).__name__ == "RehearsalError":
            sys.exit(f"entire rehearsal: Rehearsal refused the request: {exc}")
        raise


if __name__ == "__main__":
    main()
